# Template only. Replace every REPLACE_* value through the approved secret/configuration process.
# Do not install this file with placeholders, commit populated values, or use the server's
# network-adjacent Mongo/Postgres containers without separately proving database ownership.
ENVIRONMENT=production
ALLOWED_HOSTS=REPLACE_WITH_APPROVED_DMS_HOSTS
REACT_LANDING_URL=REPLACE_WITH_APPROVED_FRONTEND_URL
DUNGEONMIND_API_URL=REPLACE_WITH_APPROVED_PUBLIC_API_URL
AUTH_TRUSTED_FRONTEND_ORIGINS=REPLACE_WITH_APPROVED_FRONTEND_ORIGINS

# Session and identity provider credentials. Values are intentionally absent.
SESSION_SECRET_KEY=REPLACE_WITH_SECRET
GOOGLE_CLIENT_ID=REPLACE_WITH_OAUTH_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_SECRET
SERVICE_ACCOUNT_PATH=/etc/dungeonmindserver/secrets/service-account.json
OPENAI_API_KEY=REPLACE_WITH_SECRET

# Optional product integrations. Configure only after their owner approves the use.
FAL_KEY=REPLACE_WITH_SECRET
R2_ACCESS_KEY_ID=REPLACE_WITH_SECRET
R2_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET
CLOUDFLARE_ACCOUNT_ID=REPLACE_WITH_ACCOUNT_ID
CLOUDFLARE_IMAGES_API_TOKEN=REPLACE_WITH_SECRET
R2_BUCKET_NAME=REPLACE_WITH_APPROVED_BUCKET
EXTERNAL_MESSAGE_API_KEY=REPLACE_WITH_SECRET
EXTERNAL_SMS_ENDPOINT=REPLACE_WITH_APPROVED_ENDPOINT
TWILIO_ACCOUNT_SID=REPLACE_WITH_SECRET
TWILIO_AUTH_TOKEN=REPLACE_WITH_SECRET

# Dedicated Rules Lawyer Mongo authority: resolve host, database and role before staging.
# Do not leave MONGODB_URI unset: the application otherwise defaults to localhost:27017.
MONGODB_URI=REPLACE_WITH_DEDICATED_MONGODB_URI
RULESLAWYER_DB_NAME=REPLACE_WITH_DEDICATED_RULESLAWYER_DATABASE
RULESLAWYER_RULEBOOKS_COLLECTION=REPLACE_WITH_RULEBOOKS_COLLECTION
RULESLAWYER_INGESTION_COLLECTION=REPLACE_WITH_INGESTION_COLLECTION

# Candidate durable corpus location; the exact retained corpus and its owner are unresolved.
RULESLAWYER_DATA_DIR=/var/lib/dungeonmindserver/ruleslawyer-data

# Production guard: test mode must remain false.
TWILIO_TEST_MODE=false
